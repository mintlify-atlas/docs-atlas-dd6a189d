  "keyFeatures": [
    "Dynamic vinyl catalog powered by the Discogs API with search and genre filtering",
    "Album detail modal with YouTube video embed, Last.fm artist bio, and personalized recommendations",
    "Shopping cart persisted in localStorage with real-time cross-tab synchronization",
    "Two-step checkout flow (shipping address + card data) posting to the backend",
    "JWT-based authentication with login and account registration",
    "Role-based access control (cliente, vendedor, admin, demo)",
    "Admin panel with user management (role change, deletion) and sales management (status updates, detail modals)",
    "Read-only demo mode for the admin panel",
    "Responsive design with CSS custom properties, Playfair Display, DM Sans, and DM Mono typography",
    "Deployed as a static site on GitHub Pages — zero build step required"
  ],
  "publicApiSurface": [
    "POST /login",
    "POST /registro",
    "GET /recientes",
    "GET /buscar?q={query}&pagina={page}",
    "GET /disco/{discogsId}",
    "GET /disco/{discogsId}/historia",
    "GET /disco/{discogsId}/video",
    "GET /disco/{discogsId}/recomendaciones",
    "GET /genero/{genre}?pagina={page}",
    "POST /checkout",
    "GET /historial",
    "GET /mis-compras",
    "GET /admin/usuarios",
    "PUT /admin/usuarios/{id}/rol",
    "DELETE /admin/usuarios/{id}",
    "GET /admin/ventas",
    "GET /admin/ventas/{id}",
    "PUT /admin/ventas/{id}/estado"
  ]
